# ==============================================================================
# ONLINE CLASSROOM SYSTEM — FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Backend NestJS API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Frontend Base URL (Dùng cho link meeting, chia sẻ bài viết, QR code)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Khóa giải mã JWT Token trong Next.js Middleware (Phải trùng khớp JWT_SECRET ở Backend)
JWT_SECRET_KEY=your_jwt_secret_key_matching_backend

# ImageKit (CDN hiển thị hình ảnh & video)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_your_imagekit_public_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint"

# Stream Video (Video Call / Phòng học trực tuyến)
NEXT_PUBLIC_STREAM_API_KEY=your_stream_video_api_key

# Pusher Realtime (Tin nhắn, Bảng trắng & Thông báo thời gian thực)
NEXT_PUBLIC_PUSHER_KEY=your_pusher_app_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
